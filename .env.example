# Copy to .env (git-ignored) or export in your shell. All optional:
# without any key Glance Brief runs on built-in demo data + local reply templates.

# LLM for reply drafts (first one set wins)
# Optional override: openrouter | minimax | template
LLM_PROVIDER=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.cn/v1
MINIMAX_MODEL=MiniMax-M3.1-Flash

# Speech-to-text for voice replies (MiniMax asr-1.0, uses MINIMAX_API_KEY)
STT_LANGUAGE=en

# Google Workspace (Gmail + Calendar). Create an OAuth "Web" client, add the redirect URI,
# then open http://localhost:8787/auth/google in a normal browser to link your account.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/auth/google/callback
GLANCE_VIPS=boss@example.com,client@example.com
# Force demo data even when Google is linked
GLANCE_DEMO=
